# Copiá este archivo a .env.local (local) y cargá los valores reales en Vercel → Settings →
# Environment Variables. Todas son SOLO de servidor: nunca uses prefijo VITE_ para estas claves.

# Neon — conexión pooled (host con -pooler). La usan las Functions de api/ vía Prisma.
# Si falta en local, la API usa un almacenamiento en memoria (no persiste); en Vercel responde 503.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon — conexión directa (sin -pooler). La usa `prisma migrate` (DDL). Apuntar a la rama dev.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Token del panel /admin (provisorio hasta spec-04, ADR-0008). Mínimo 24 caracteres.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=""

# Sal del hash de IP para el rate limit (ADR-0010): la tabla rate_limits nunca guarda la IP en claro.
# Generala igual que ADMIN_TOKEN. Si falta, el límite funciona igual pero el hash es más fácil de revertir.
IP_HASH_SALT=""
